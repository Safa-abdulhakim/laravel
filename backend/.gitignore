# Python byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment variable files (never commit secrets)
.env
.env.local
.env.production

# Model artefacts (large binary files — distribute separately)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.bin
# Keep the placeholder so the directory is tracked by git
!models/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# mypy / pyright type-checking
.mypy_cache/
.pyright/
pyrightconfig.json

# IDE / editor artefacts
.vscode/
.idea/
*.swp
*.swo
*~

# OS artefacts
.DS_Store
Thumbs.db
